  definition: {fileID: 1478376965}
  animRest: Reposo
  animGreet: Saludo
  animBook: Incorrecto
  animDoubt: Duda
  animQuiz: Quiz
  animTalk: Hablando
  animRead: VozAlta
  animThink: Pensando
  animWrong: Incorrecto
  animRight: Correcto
  saludoNombre:
    id: 01_saludo_nombre
    text: "\xA1Hola! \xA1Bienvenido al libro El Principito! \xBFC\xF3mo te llamas?"
    clip: {fileID: 8300000, guid: c864a0979b8168f4cadaf9db4d63873d, type: 3}
  nameReply:
    id: 02_nombre
    text: "\xA1Qu\xE9 lindo nombre! Antes de empezar nuestra aventura, te voy a contar
      tres reglas muy f\xE1ciles."
    clip: {fileID: 8300000, guid: 5c78bb8d28bf7d949b5987733e26b8e6, type: 3}
  intro:
    id: 01_intro
    text: "\xA1Hola! \xA1Bienvenido al libro El Principito! Antes de empezar nuestra
      aventura, te voy a comentar unas reglas muy f\xE1ciles."
    clip: {fileID: 8300000, guid: 08da2dba26bb7214bb3d7c5bc1995bbc, type: 3}
  bookLine:
    id: 02_libro
    text: "Primero: no tapes el cuadrado de barras con tus manos. As\xED s\xE9 en
      qu\xE9 p\xE1gina est\xE1s."
    clip: {fileID: 8300000, guid: 6e150277c0b5b70448a2c8e2ed3aed9c, type: 3}
  readLine:
    id: 03_voz_alta
    text: "Segundo: lee en voz alta. As\xED podr\xE1s ver animaciones durante la
      historia."
    clip: {fileID: 8300000, guid: 58c5a4fc84bacc749b34c2fe3794cfee, type: 3}
  quizLine:
    id: 04_quiz
    text: "Tercero: al terminar cada cap\xEDtulo, te har\xE9 dos preguntas sobre
      lo que le\xEDste. Responde diciendo la letra de la opci\xF3n. Si eliges una
      respuesta que no es, no pasa nada. \xA1Puedes intentarlo otra vez!"
    clip: {fileID: 8300000, guid: 0ea2b20e5d103f243b592ec5723d4c44, type: 3}
  finalLine:
    id: 05_final
    text: "Y cuando aciertes, \xA1lo celebramos juntos! \xBFEst\xE1s listo?"
    clip: {fileID: 8300000, guid: 5ea094b061227df49be8869bc61294c4, type: 3}
  readyLine:
    id: 06_listo
    text: "\xA1Genial! Pasa la p\xE1gina y empieza a leer en voz alta."
    clip: {fileID: 8300000, guid: 2f25ab39ad81c884dad90e6e368a3bf2, type: 3}
  doubtLine:
    id: 04_duda
    text: "Si tienes una duda, ll\xE1mame diciendo: Principito, tengo una duda."
    clip: {fileID: 8300000, guid: baab3d6a6b48b414c9cb0cb2961e1a9b, type: 3}
