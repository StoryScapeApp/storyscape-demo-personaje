--- !u!114 &461914787
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 461914786}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b4f81d6ea02c8f640b58f89a35438367, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OnboardingSequence
  startOnPlay: 0
  startDelay: 1
  principito: {fileID: 1367030906}
  voice: {fileID: 798142288}
  listener: {fileID: 798142287}
  principitoFade: 0.8
  cardBook: {fileID: 1402922321}
  markerFrame: {fileID: 223083698}
  cardRead: {fileID: 987859758}
  meteor: {fileID: 776551145}
  planet: {fileID: 932782533}
  meteorStartTime: 5.75
  cardDoubt: {fileID: 102674640}
  wordHighlight: {fileID: 1869955604}
  definition: {fileID: 909216550}
  quizPanel: {fileID: 126061480}
  quizTitle: {fileID: 1345932759}
  question: {fileID: 2030245937}
  options:
  - {fileID: 1014548256}
  - {fileID: 274124865}
  - {fileID: 1641476739}
  wrongOption: 0
  rightOption: 1
  stars: {fileID: 242872462}
  animRest: Reposo
  animGreet: Saludo
  animDoubt: Duda
  animQuiz: Quiz
  animWrong: Incorrecto
  animRight: Correcto
  intro:
    id: 01_intro
    text: "\xA1Hola! \xA1Bienvenido al libro El Principito! Antes de empezar nuestra
      aventura, te voy a comentar unas reglas muy f\xE1ciles."
    clip: {fileID: 8300000, guid: 08da2dba26bb7214bb3d7c5bc1995bbc, type: 3}
  bookLine:
    id: 02_libro
    text: "Primero: no tapes el cuadro negro con tus manos. As\xED s\xE9 en qu\xE9
      p\xE1gina est\xE1s."
    clip: {fileID: 8300000, guid: 6e150277c0b5b70448a2c8e2ed3aed9c, type: 3}
  readLine:
    id: 03_voz_alta
    text: "Segundo: lee en voz alta. As\xED podr\xE1s ver animaciones durante la
      historia. \xA1Mira, ah\xED va un meteoro!"
    clip: {fileID: 8300000, guid: 58c5a4fc84bacc749b34c2fe3794cfee, type: 3}
  doubtLine:
    id: 04_duda
    text: "Tercero: si tienes una duda, ll\xE1mame diciendo: Principito, tengo una
      duda."
    clip: {fileID: 8300000, guid: baab3d6a6b48b414c9cb0cb2961e1a9b, type: 3}
  doubtExample:
    id: 04b_duda_ejemplo
    text: "Por ejemplo, si no entiendes la palabra dedicatoria, te la marco en el
      libro y te cuento lo que significa: son palabras al inicio de un libro para
      regal\xE1rselo a alguien especial como cuando escribes \"Para mi mam\xE1\"
      en un dibujo que le regalas."
    clip: {fileID: 8300000, guid: 4c421a6bf8d2cfa43b5ab881b256c56c, type: 3}
  quizLine:
    id: 04c_quiz
    text: "Y al terminar cada cap\xEDtulo, te har\xE9 dos preguntas sobre lo que
      le\xEDste."
    clip: {fileID: 8300000, guid: 13d9a50e9263f034eb96800ef417e6c8, type: 3}
  quizIntro:
    id: 05_juego_intro
    text: "Mira, as\xED se ver\xE1n las preguntas. Por ejemplo: \xBFc\xF3mo vas a
      leer el cuento? \xBFEn silencio, en voz alta o cantando? Se responde diciendo
      la letra de la opci\xF3n."
    clip: {fileID: 8300000, guid: 66677cb01f791924d93ac0679a10e1fa, type: 3}
  quizWrong:
    id: 06_juego_casi
    text: "Si eliges una respuesta que no es como por ejemplo la opci\xF3n A, no
      pasa nada. \xA1Puedes intentarlo otra vez!"
    clip: {fileID: 8300000, guid: 30d7e29ee94a8cc4dacae886e23141b6, type: 3}
  quizRight:
    id: 07_juego_bien
    text: "Y cuando aciertes, \xA1lo celebramos juntos! \xBFEst\xE1s listo? \xA1Empecemos!"
    clip: {fileID: 8300000, guid: 80d8b6380da74834c8d9142e1c035aa5, type: 3}
  farewell:
    id: 08_final
    text: "\xA1Genial! Pasa la p\xE1gina y empieza a leer en voz alta."
    clip: {fileID: 8300000, guid: 2f25ab39ad81c884dad90e6e368a3bf2, type: 3}
  pauseBetweenLines: 0.35
  choiceThinkTime: 1.4
  cleanupFade: 1.2
  onStarted:
    m_PersistentCalls:
      m_Calls: []
  onFinished:
    m_PersistentCalls:
      m_Calls: []
  closing:
    id: 
    text: 
    clip: {fileID: 0}
