MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1078263767}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b4f81d6ea02c8f640b58f89a35438367, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::OnboardingSequence
  startOnPlay: 1
  startDelay: 1
  principito: {fileID: 596977077}
  voice: {fileID: 1404160377}
  listener: {fileID: 1404160376}
  rulesTitle: {fileID: 71005286}
  rules:
  - {fileID: 1911290350}
  - {fileID: 1293733648}
  - {fileID: 1874133641}
  question: {fileID: 474159636}
  options:
  - {fileID: 1345080504}
  - {fileID: 793484484}
  - {fileID: 271353795}
  wrongOption: 0
  rightOption: 1
  bubble: {fileID: 0}
  stars: {fileID: 1094693388}
  animRest: Reposo
  animRule1: Listening
  animRule2: Asking
  animRule3: 
  animWrong: Incorrecto
  animRight: Correcto
  intro:
    id: 01_intro
    text: "\xA1Hola! \xA1Bienvenido al libro El Principito! \xBFC\xF3mo te llamas?"
    clip: {fileID: 8300000, guid: 08da2dba26bb7214bb3d7c5bc1995bbc, type: 3}
  nameReply:
    id: 02_nombre
    text: "\xA1Qu\xE9 lindo nombre! Antes de empezar nuestra aventura, te voy a contar
      tres reglas muy f\xE1ciles."
    clip: {fileID: 8300000, guid: 6bf1da2829a27ec4190a8d6e054e620c, type: 3}
  rule1:
    id: 03_regla1
    text: "Uno: lee en voz alta. As\xED yo puedo escucharte y acompa\xF1arte en la
      lectura."
    clip: {fileID: 8300000, guid: 9be28c91ca5bb92459197eb3cd98047e, type: 3}
  rule2:
    id: 04_regla2
    text: "Dos: si tienes una duda, p\xEDdeme ayuda. Solo tienes que decir: Principito,
      tengo una duda, y yo te ayudar\xE9."
    clip: {fileID: 8300000, guid: a796396cc1ae02c4bad4af3d0c64ed14, type: 3}
  rule3:
    id: 05_regla3
    text: "Tres: al terminar cada cap\xEDtulo, jugaremos a las preguntas. Te har\xE9
      dos preguntas sobre lo que le\xEDste. \xA1No te preocupes, no es un examen,
      es un juego!"
    clip: {fileID: 8300000, guid: bf03ca99a9e97454b931479c691e4713, type: 3}
  quizIntro:
    id: 06_juego_intro
    text: "Mira, as\xED se ver\xE1 el juego. Por ejemplo: \xBFc\xF3mo vas a leer
      el cuento? \xBFEn silencio, en voz alta o cantando?"
    clip: {fileID: 8300000, guid: 3b426c153bbbf5046acb56fd5ee4218e, type: 3}
  quizWrong:
    id: 07_juego_casi
    text: "Si eliges una respuesta que no es, no pasa nada. \xA1Puedes intentarlo
      otra vez!"
    clip: {fileID: 8300000, guid: 97bcf8f8c1f849b47920f64826d514ab, type: 3}
  quizRight:
    id: 08_juego_bien
    text: "Y cuando aciertes, \xA1lo celebramos juntos! \xBFEst\xE1s listo? \xA1Empecemos!"
    clip: {fileID: 8300000, guid: 80d8b6380da74834c8d9142e1c035aa5, type: 3}
  closing:
    id: 
    text: 
    clip: {fileID: 0}
  farewell:
    id: 09_final
    text: "\xA1Genial! Pasa la p\xE1gina y empieza a leer en voz alta."
    clip: {fileID: 8300000, guid: 2f25ab39ad81c884dad90e6e368a3bf2, type: 3}
  pauseBetweenLines: 0.35
  choiceThinkTime: 1.4
  onStarted:
    m_PersistentCalls:
      m_Calls: []
  onFinished:
    m_PersistentCalls:
      m_Calls: []
